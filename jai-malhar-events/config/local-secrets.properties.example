# Copy this file to local-secrets.properties and replace the placeholder values.
# The real local-secrets.properties file is ignored by Git.
ADMIN_USERNAME=replace-with-your-admin-username
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Database connection details. Copy the hostname and port from the Aiven
# service's Connection information page. Do not include "jdbc:mysql://" in
# DB_HOST, and do not commit the populated local-secrets.properties file.
DB_HOST=your-service.aivencloud.com
DB_PORT=your-aiven-mysql-port
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=replace-with-your-aiven-password
